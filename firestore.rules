rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ----------------------------------------------------------------------
    // GLOBAL SECURITY PRIMITIVES & IDENTITY HELPERS
    // ----------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Hardened Admin check: Trusted admin document or verified bootstrap admin
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email_verified == true && request.auth.token.email == 'kaamikayani@gmail.com')
      );
    }

    function isMunicipalWorker() {
      return isSignedIn() && (
        isAdmin() ||
        exists(/databases/$(database)/documents/workers/$(request.auth.uid))
      );
    }

    // ----------------------------------------------------------------------
    // DOMAIN VALUE VALIDATORS
    // ----------------------------------------------------------------------
    function isValidStatus(status) {
      return status in ['OPEN', 'IN_PROGRESS', 'RESOLVED', 'CLOSED', 'REJECTED'];
    }

    function isValidCategory(cat) {
      return cat in ['POTHOLE', 'LIGHTING', 'SANITATION', 'VANDALISM', 'WATER_LEAK', 'ROADS_TRAFFIC', 'PARKS_RECREATION', 'STREET_SIGN', 'OTHER'];
    }

    function isValidSeverity(sev) {
      return sev in ['LOW', 'MEDIUM', 'HIGH', 'CRITICAL'];
    }

    // ----------------------------------------------------------------------
    // ENTITY SCHEMAS & FIELD SIZE GUARDS
    // ----------------------------------------------------------------------
    function isValidReport(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
             data.description is string && data.description.size() <= 5000 &&
             data.category is string &&
             data.status is string &&
             data.severity is string;
    }

    function isValidComment(data) {
      return data.reportId is string &&
             data.userName is string && data.userName.size() > 0 && data.userName.size() <= 150 &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 2000;
    }

    function isValidVerification(data) {
      return data.reportId is string &&
             data.userName is string && data.userName.size() > 0 && data.userName.size() <= 150 &&
             data.statusConfirmed is string;
    }

    function isValidUserProfile(data) {
      return data.username is string && data.username.size() > 0 && data.username.size() <= 100 &&
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 150;
    }

    function isValidHashtag(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100;
    }

    function isValidMunicipalStaff(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.role is string && data.role.size() > 0 && data.role.size() <= 50 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.badgeId is string && data.badgeId.size() > 0 && data.badgeId.size() <= 60;
    }

    function isValidTaskAssignment(data) {
      return data.reportId is string &&
             data.assignedStaffId is string && data.assignedStaffId.size() > 0 && data.assignedStaffId.size() <= 128 &&
             data.assignedStaffName is string && data.assignedStaffName.size() > 0 && data.assignedStaffName.size() <= 150 &&
             data.assignedByExecutiveName is string && data.assignedByExecutiveName.size() > 0 && data.assignedByExecutiveName.size() <= 150;
    }

    // ----------------------------------------------------------------------
    // DEFAULT-DENY GLOBAL CATCH-ALL
    // ----------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // ----------------------------------------------------------------------
    // CONNECTION & HEALTH CHECK
    // ----------------------------------------------------------------------
    match /test/connection {
      allow read: if true;
    }

    // ----------------------------------------------------------------------
    // ADMINS & MUNICIPAL WORKERS ROSTER
    // ----------------------------------------------------------------------
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /workers/{workerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ----------------------------------------------------------------------
    // REPORTS COLLECTION
    // ----------------------------------------------------------------------
    match /reports/{reportId} {
      allow read: if true;
      allow create: if isValidId(reportId) && isValidReport(incoming());
      
      allow update: if isValidId(reportId) && isValidReport(incoming());
      
      allow delete: if isAdmin() || (isSignedIn() && existing().get('userId', '') == request.auth.uid);

      // Comments Subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isValidId(commentId) && isValidComment(incoming());
        allow update, delete: if isAdmin();
      }

      // Verifications Subcollection
      match /verifications/{verificationId} {
        allow read: if true;
        allow create: if isValidId(verificationId) && isValidVerification(incoming());
        allow update, delete: if isAdmin();
      }
    }

    // ----------------------------------------------------------------------
    // MUNICIPAL STAFF & EXECUTIVES DIRECTORY
    // ----------------------------------------------------------------------
    match /municipal_staff/{staffId} {
      allow read: if true;
      allow create, update: if isValidId(staffId) && isValidMunicipalStaff(incoming());
      allow delete: if isAdmin();
    }

    // ----------------------------------------------------------------------
    // TASK ASSIGNMENTS LOG
    // ----------------------------------------------------------------------
    match /assignments/{assignmentId} {
      allow read: if true;
      allow create, update: if isValidId(assignmentId) && isValidTaskAssignment(incoming());
      allow delete: if isAdmin();
    }

    // ----------------------------------------------------------------------
    // USERS COLLECTION (PII ISOLATION & SCRAPING GUARD)
    // ----------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false; // Prevents bulk database scraping
      allow create, update: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming());
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ----------------------------------------------------------------------
    // CIVIC HASHTAGS INDEX
    // ----------------------------------------------------------------------
    match /hashtags/{hashtagId} {
      allow read: if true;
      allow create, update: if isValidId(hashtagId) && isValidHashtag(incoming());
      allow delete: if isAdmin();
    }
  }
}
